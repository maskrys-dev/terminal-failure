{
  "experiment": "e15_recursive_tinyimagenet_aligned_t32",
  "status": "frozen_before_first_scientific_result",
  "protocol": "Rebuttal/Terminal_Failure_E15_Aligned_Horizon_Protocol.md",
  "dataset": {
    "name": "Tiny ImageNet-200",
    "root": "data/tiny-imagenet-200",
    "train_examples": 100000,
    "validation_examples": 10000,
    "classes": 200,
    "split": "standard train/labelled validation",
    "augmentation": false
  },
  "backbone": {
    "name": "torchvision.models.convnext_tiny",
    "weights": "ConvNeXt_Tiny_Weights.DEFAULT",
    "frozen": true,
    "feature_dimension": 768,
    "preprocessing": "weights.transforms()",
    "feature_extraction_batch_size": 128,
    "feature_cache_path": "results/rebuttal_recursive_tinyimagenet/feature_cache.pt"
  },
  "architecture": {
    "input_dimension": 768,
    "state_dimension": 512,
    "intermediate_dimension": 2048,
    "normalisation": "LayerNorm",
    "activation": "SwiGLU",
    "dropout": 0.1,
    "weight_tied": true,
    "input_conditioned_after_h0": false,
    "residual_scale": "lambda / training_horizon",
    "training_horizon": 32,
    "training_gain": 1.0,
    "shared_classifier": true
  },
  "training": {
    "objective": "terminal_cross_entropy_only",
    "optimizer": "AdamW",
    "learning_rate": 0.0003,
    "weight_decay": 0.01,
    "batch_size": 512,
    "epochs": 30,
    "warmup_epochs": 2,
    "schedule": "cosine_decay",
    "label_smoothing": 0.1,
    "gradient_clip_norm": 1.0,
