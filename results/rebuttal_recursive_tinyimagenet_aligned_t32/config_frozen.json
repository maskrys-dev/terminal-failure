  "evaluation": {
    "trajectory_horizon": 32,
    "gain_grid": [0.75, 1.0, 1.1, 1.2, 1.3, 1.4, 1.5, 1.6],
    "headline_gains": [1.0, 1.3, 1.6],
    "early_window": 8,
    "random_chance_accuracy": 0.005
  },
  "readouts": {
    "terminal": true,
    "early_window": true,
    "uniform": true,
    "adaptive_stopping": {
      "norm_ratio_threshold": 1.5
    },
    "grace": {
      "norm_ratio_threshold": 1.2,
      "alpha": 10.0
    },
    "fixed_grace_profile": {
      "reference_gain": 1.3,
      "source_split": "full_training_split",
      "profile": "mean_of_normalized_per_sample_grace_weights"
    }
  },
  "probes": {
    "classifier": "sklearn.linear_model.RidgeClassifier",
    "alpha": 1.0,
    "training_subset_size": 20000,
    "training_subset_seed": 2026,
    "validation_subset": "full",
    "dense_timestep_gains": [1.0, 1.3, 1.6],
    "grace_period_accuracy_thresholds": [0.4, 0.5, 0.6]
  },
  "continuation_gate": {
    "comparison_policy": "shared_head_only",
    "minimum_early_minus_terminal_pp": 1.0,
    "required_consecutive_gains": 3,
    "minimum_gain_for_sequence": 1.2,
    "stable_gain": 1.0,
    "maximum_stable_terminal_deficit_pp": 0.5,
    "structure_rule": "gap_increases_or_peak_shifts_earlier",
    "structure_minimum_gain": 1.2,
    "minimum_material_accuracy": 0.025,
    "required_seed_sign_agreement": "2_of_3"
  },
  "benchmark": {
    "batch_size": 512,
    "trajectory_horizon": 32,
    "state_dimension": 512,
    "warmup_repetitions": 10,
    "timed_repetitions": 25,
    "statistic": "median"
  },
  "smoke_test": {
    "training_examples": 4000,
    "validation_examples": 2000,
    "epochs": 3,
    "minimum_validation_accuracy": 0.025
  }
